[Unit]
Description=DSV 出货手续包邮件守护（IMAP 收转发邮件 -> 自动生成手续包 -> 回信）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
; 按实际部署位置修改：工作目录 = scripts 目录
WorkingDirectory=/opt/dsv/waybill-workflow-skill/scripts
ExecStart=/usr/bin/python3 mail_daemon.py
Restart=always
RestartSec=10
; 服务器无桌面：不开浏览器/不弹窗
Environment=RUNPKG_NO_OPEN=1
Environment=PYTHONIOENCODING=utf-8
; 按需改运行用户（建议非 root）
User=dsv

[Install]
WantedBy=multi-user.target
